{
  "name": "screenlink",
  "version": "0.6.1",
  "private": true,
  "description": "Your personal iPhone screen receiver",
  "author": "ScreenLink",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./ && esbuild ../server/app.mjs --bundle --platform=node --format=esm --outfile=backend/app.mjs",
    "start": "electron .",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File build-input.ps1 && npm run build && electron-builder --win portable --x64",
    "test": "node --test runtime-paths.test.cjs"
  },
  "dependencies": {
    "livekit-client": "2.23.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "png-to-ico": "3.0.2",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "personal.screenlink.desktop",
    "productName": "ScreenLink",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "assets/icon.ico",
      "runtime-paths.cjs"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "artifactName": "ScreenLink-Windows-${version}.${ext}",
    "extraResources": [
      {
        "filter": [
          "app.mjs"
        ],
        "to": "server",
        "from": "backend"
      },
      {
        "from": "InputHost.exe",
        "to": "InputHost.exe"
      }
    ]
  }
}
